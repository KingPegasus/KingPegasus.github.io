---
const { project, extra = false } = Astro.props;
---

<article class:list={["glass", "project-card", { "project-extra": extra }]}>
  {project.data.image && (
    <div class:list={["project-image-wrap", { "tone-dark": project.data.imageTone === "dark" }]}>
      <img src={project.data.image} alt={`${project.data.title} screenshot`} class="project-image" loading="lazy" decoding="async" />
    </div>
  )}
  <h3 class="project-title">{project.data.title}</h3>
  <p class="project-summary">{project.data.summary}</p>
  {project.data.url && (
    <a href={project.data.url} target="_blank" rel="noreferrer" class="accent-link project-link">
      Visit {project.data.title} &rarr;<span class="sr-only"> (opens in new tab)</span>
    </a>
  )}
  <div class="project-tags">
    {project.data.tags.map((tag: string) => <span class="chip">{tag}</span>)}
  </div>
</article>

<style>
  .project-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    position: relative;
    overflow: hidden;
  }
  .project-image-wrap {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 0.2rem;
    border: 1px solid var(--border);
    background: var(--tile);
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
  }
  .project-image-wrap.tone-dark {
    background: #111114;
  }
  .project-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }
  .project-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .project-summary {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .project-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: auto;
  }
  .project-link {
    font-size: 0.88rem;
    margin-top: 0.25rem;
    margin-bottom: 0.1rem;
  }

  @media (max-width: 768px) {
    .project-card {
      padding: 1.25rem;
    }
    .project-image-wrap {
      height: 180px;
      padding: 1rem;
    }
    .project-summary {
      line-height: 1.65;
    }
  }
</style>
